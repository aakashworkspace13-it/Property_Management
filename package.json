{
  "name": "family-property-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tracker": "node scripts/build-tracker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "node scripts/firebase.js emulators:start --project demo-family-property",
    "test:rules": "node scripts/firebase.js emulators:exec --only firestore --project demo-family-property \"vitest run --config vitest.rules.config.js\"",
    "deploy:rules": "node scripts/firebase.js deploy --only firestore:rules --project prod"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.4",
    "vitest": "^5.1.1"
  }
}
