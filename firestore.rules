rules_version = '2';

// Family Property Manager — Firestore security rules.
// Default: everything is denied. Each collection below opens only what it needs.
// Tested in tests/rules/ against the Firestore emulator (npm run test:rules).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity helpers ----------

    // Signed in with a verified email (Google accounts are always verified).
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function memberPath(email) {
      return /databases/$(database)/documents/members/$(email);
    }

    function setupPath() {
      return /databases/$(database)/documents/config/setup;
    }

    // Active family member (state before this request).
    function isMember() {
      return signedIn()
        && exists(memberPath(myEmail()))
        && get(memberPath(myEmail())).data.active == true;
    }

    function isAdmin() {
      return isMember() && get(memberPath(myEmail())).data.role == 'admin';
    }

    // Active member once this request's batch is applied (used for the owner setup batch).
    function isMemberAfter() {
      return signedIn()
        && existsAfter(memberPath(myEmail()))
        && getAfter(memberPath(myEmail())).data.active == true;
    }

    // ---------- one-time owner setup ----------
    // The first person to sign in on a fresh database can become the owner (first admin),
    // only in the same batch that creates their admin member record. Never again after that.

    match /config/setup {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(setupPath())
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(memberPath(myEmail()))
        && getAfter(memberPath(myEmail())).data.role == 'admin';
      allow update, delete: if false;
    }

    // ---------- family members (allowlist) ----------

    function validMember(email) {
      let d = request.resource.data;
      return d.keys().hasAll(['email', 'name', 'role', 'active', 'addedBy', 'addedAt'])
        && d.keys().hasOnly(['email', 'name', 'role', 'active', 'addedBy', 'addedAt', 'updatedBy', 'updatedAt'])
        && email == email.lower()
        && d.email == email
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.role in ['admin', 'family']
        && d.active is bool;
    }

    match /members/{email} {
      // Members see the whole list; anyone signed in may check their own record.
      allow read: if isMember() || (signedIn() && email == myEmail());

      allow create: if validMember(email)
        && request.resource.data.addedAt == request.time
        && request.resource.data.addedBy == myEmail()
        && !('updatedAt' in request.resource.data)
        && (
          // an admin adds someone
          isAdmin()
          // or the owner-setup batch creates the first admin (themselves)
          || (signedIn()
              && email == myEmail()
              && !exists(setupPath())
              && existsAfter(setupPath())
              && getAfter(setupPath()).data.ownerUid == request.auth.uid
              && request.resource.data.role == 'admin'
              && request.resource.data.active == true)
        );

      allow update: if isAdmin()
        && validMember(email)
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.addedAt == resource.data.addedAt
        && request.resource.data.updatedBy == myEmail()
        && request.resource.data.updatedAt == request.time
        // an admin can never demote or deactivate themselves (no lock-out)
        && (email != myEmail()
            || (request.resource.data.role == 'admin' && request.resource.data.active == true));

      // Members are deactivated, never deleted, so history keeps its names.
      allow delete: if false;
    }

    // ---------- audit log (append-only) ----------

    match /auditLogs/{entryId} {
      // Change history is visible to admins only (owner choice 2026-11-21).
      allow read: if isAdmin();
      allow create: if isMemberAfter()
        && request.resource.data.keys().hasOnly(
             ['actorUid', 'actorEmail', 'action', 'entity', 'entityId', 'changedFields', 'before', 'after', 'at'])
        && request.resource.data.keys().hasAll(['actorUid', 'actorEmail', 'action', 'entity', 'entityId', 'at'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == myEmail()
        && request.resource.data.at == request.time
        && request.resource.data.action is string
        && request.resource.data.entity is string
        && request.resource.data.entityId is string;
      allow update, delete: if false;
    }

    // ---------- shared field checks ----------

    function optionalText(d, field, max) {
      return !(field in d) || (d[field] is string && d[field].size() <= max);
    }

    // Create: stamped with the creator and server time, no update stamps yet.
    function createStamped() {
      let d = request.resource.data;
      return d.createdBy == myEmail()
        && d.createdAt == request.time
        && !('updatedAt' in d) && !('updatedBy' in d);
    }

    // Update: creation stamps unchanged, update stamps set to the editor and server time.
    function updateStamped() {
      let d = request.resource.data;
      return d.createdBy == resource.data.createdBy
        && d.createdAt == resource.data.createdAt
        && d.updatedBy == myEmail()
        && d.updatedAt == request.time;
    }

    function unchanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields) == false;
    }

    // ---------- buildings ----------
    // Admins manage buildings; every member can read them. Never deleted.

    function validBuilding(code) {
      let d = request.resource.data;
      return d.keys().hasAll(['code', 'name', 'ownUse', 'createdAt', 'createdBy'])
        && d.keys().hasOnly(['code', 'name', 'address', 'ownUse', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.code == code
        && code.matches('^[A-Z0-9]{1,10}$')
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.ownUse is bool
        && optionalText(d, 'address', 300)
        && optionalText(d, 'notes', 1000);
    }

    match /buildings/{code} {
      allow read: if isMember();
      allow create: if isAdmin() && validBuilding(code) && createStamped();
      allow update: if isAdmin() && validBuilding(code) && updateStamped() && unchanged(['code']);
      allow delete: if false;
    }

    // ---------- electricity connections (one per CA number) ----------

    function validConnection(ca) {
      let d = request.resource.data;
      return d.keys().hasAll(['caNumber', 'type', 'submeter', 'createdAt', 'createdBy'])
        && d.keys().hasOnly(['caNumber', 'type', 'submeter', 'holderName', 'holderPhone', 'holderEmail', 'provider', 'notes',
                             'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.caNumber == ca
        && ca.matches('^[A-Z0-9_-]{1,30}$')
        && d.type in ['domestic', 'commercial']
        && d.submeter is bool
        && optionalText(d, 'holderName', 80)
        && optionalText(d, 'holderPhone', 20)
        && optionalText(d, 'holderEmail', 120)
        && optionalText(d, 'provider', 80)
        && optionalText(d, 'notes', 1000);
    }

    match /connections/{ca} {
      allow read: if isMember();
      allow create: if isAdmin() && validConnection(ca) && createStamped();
      allow update: if isAdmin() && validConnection(ca) && updateStamped() && unchanged(['caNumber']);
      allow delete: if false;
    }

    // ---------- flats ----------
    // The flat code (document ID) is building-floorKey-positionKey, so the same floor and position
    // can never exist twice in a building. Identity fields never change after creation.

    function validFlat(code) {
      let d = request.resource.data;
      return d.keys().hasAll(['code', 'buildingId', 'floor', 'floorKey', 'floorOrder', 'position', 'positionKey', 'ownUse',
                              'createdAt', 'createdBy'])
        && d.keys().hasOnly(['code', 'buildingId', 'floor', 'floorKey', 'floorOrder', 'position', 'positionKey', 'friendlyName',
                             'ownUse', 'connectionId', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.code == code
        && d.buildingId is string && d.floorKey is string && d.positionKey is string
        && d.floorKey.matches('^[A-Z0-9]{1,12}$') && d.positionKey.matches('^[A-Z0-9]{1,12}$')
        && code == d.buildingId + '-' + d.floorKey + '-' + d.positionKey
        && existsAfter(/databases/$(database)/documents/buildings/$(d.buildingId))
        && d.floor is string && d.floor.size() > 0 && d.floor.size() <= 40
        && d.position is string && d.position.size() > 0 && d.position.size() <= 40
        && d.floorOrder is int
        && d.ownUse is bool
        && optionalText(d, 'friendlyName', 80)
        && optionalText(d, 'notes', 1000)
        && (!('connectionId' in d) || d.connectionId == null
            || (d.connectionId is string && existsAfter(/databases/$(database)/documents/connections/$(d.connectionId))));
    }

    match /flats/{code} {
      allow read: if isMember();
      allow create: if isAdmin() && validFlat(code) && createStamped();
      allow update: if isAdmin() && validFlat(code) && updateStamped()
        && unchanged(['code', 'buildingId', 'floor', 'floorKey', 'floorOrder', 'position', 'positionKey']);
      allow delete: if false;
    }

    // ---------- tenants ----------
    // Family members add and edit tenants. Never deleted (history is kept).

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function optionalDate(d, field) {
      return !(field in d) || d[field] == '' || d[field] == null || isDate(d[field]);
    }

    function optionalMobile(d, field) {
      return !(field in d) || d[field] == '' || (d[field] is string && d[field].matches('^[6-9][0-9]{9}$'));
    }

    function validTenant() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'mobile', 'members', 'twoWheelers', 'fourWheelers', 'idType', 'idNumber',
                              'createdAt', 'createdBy'])
        && d.keys().hasOnly(['name', 'mobile', 'altMobile', 'emergencyName', 'emergencyRelation', 'emergencyMobile',
                             'members', 'twoWheelers', 'fourWheelers', 'idType', 'idNumber', 'notes',
                             'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.mobile is string && d.mobile.matches('^[6-9][0-9]{9}$')
        && optionalMobile(d, 'altMobile') && optionalMobile(d, 'emergencyMobile')
        && optionalText(d, 'emergencyName', 80) && optionalText(d, 'emergencyRelation', 40)
        && d.members is int && d.members >= 1 && d.members <= 30
        && d.twoWheelers is int && d.twoWheelers >= 0 && d.twoWheelers <= 20
        && d.fourWheelers is int && d.fourWheelers >= 0 && d.fourWheelers <= 20
        && d.idType in ['aadhaar', 'pan', 'voter', 'driving', 'passport', 'other']
        && d.idNumber is string && d.idNumber.size() > 0 && d.idNumber.size() <= 30
        && (d.idType != 'aadhaar' || d.idNumber.matches('^[0-9]{12}$'))
        && optionalText(d, 'notes', 1000);
    }

    match /tenants/{tenantId} {
      allow read: if isMember();
      allow create: if isMember() && validTenant() && createStamped();
      allow update: if isMember() && validTenant() && updateStamped();
      allow delete: if false;
    }

    // Passport photo of a tenant: a small JPEG data URL, added or replaced by any member.
    match /tenantPhotos/{tenantId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && exists(/databases/$(database)/documents/tenants/$(tenantId))
        && request.resource.data.keys().hasOnly(['photo', 'updatedBy', 'updatedAt'])
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 100000
        && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.updatedBy == myEmail()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---------- tenancies and the one-tenant-per-flat lock ----------
    // occupancy/{flatId} exists exactly while a flat has an active tenancy. A tenancy can only
    // start in the same write that creates the lock, so two tenants can never be active at once.

    function tenancyPath(id) {
      return /databases/$(database)/documents/tenancies/$(id);
    }

    function occupancyPath(flatId) {
      return /databases/$(database)/documents/occupancy/$(flatId);
    }

    function validTenancy() {
      let d = request.resource.data;
      return d.keys().hasAll(['tenantId', 'flatId', 'buildingId', 'moveIn', 'moveOut', 'monthlyRent', 'trackFrom',
                              'createdAt', 'createdBy'])
        && d.keys().hasOnly(['tenantId', 'flatId', 'buildingId', 'moveIn', 'moveOut', 'monthlyRent', 'trackFrom',
                             'agreementStart', 'agreementEnd', 'agreementHistory', 'notes',
                             'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && (!('agreementHistory' in d) || (d.agreementHistory is list && d.agreementHistory.size() <= 50))
        && isDate(d.moveIn) && isDate(d.trackFrom) && d.trackFrom >= d.moveIn
        && (d.moveOut == null || (isDate(d.moveOut) && d.moveOut >= d.moveIn))
        && d.monthlyRent is int && d.monthlyRent > 0 && d.monthlyRent <= 100000000
        && optionalDate(d, 'agreementStart') && optionalDate(d, 'agreementEnd')
        && optionalText(d, 'notes', 1000)
        && existsAfter(/databases/$(database)/documents/tenants/$(d.tenantId))
        && exists(/databases/$(database)/documents/flats/$(d.flatId))
        && get(/databases/$(database)/documents/flats/$(d.flatId)).data.buildingId == d.buildingId
        && get(/databases/$(database)/documents/flats/$(d.flatId)).data.ownUse == false;
    }

    match /tenancies/{tenancyId} {
      allow read: if isMember();
      allow create: if isMember() && validTenancy() && createStamped()
        && request.resource.data.moveOut == null
        && !exists(occupancyPath(request.resource.data.flatId))
        && getAfter(occupancyPath(request.resource.data.flatId)).data.tenancyId == tenancyId;
      // Agreement dates and notes can change. Move-out is set once, together with releasing the lock.
      allow update: if isMember() && validTenancy() && updateStamped()
        && unchanged(['tenantId', 'flatId', 'buildingId', 'moveIn', 'monthlyRent', 'trackFrom'])
        && (request.resource.data.moveOut == resource.data.moveOut
            || (resource.data.moveOut == null
                && request.resource.data.moveOut != null
                && !existsAfter(occupancyPath(resource.data.flatId))));
      allow delete: if false;
    }

    match /occupancy/{flatId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['tenancyId', 'since'])
        && isDate(request.resource.data.since)
        && getAfter(tenancyPath(request.resource.data.tenancyId)).data.flatId == flatId
        && getAfter(tenancyPath(request.resource.data.tenancyId)).data.moveOut == null;
      allow update: if false;
      // Released only in the same write that records the tenancy's move-out.
      allow delete: if isMember()
        && getAfter(tenancyPath(resource.data.tenancyId)).data.moveOut != null;
    }

    // ---------- documents (links to files in Google Drive) ----------
    // Each file lives in the uploader's Google Drive and is shared view-only with the family.
    // Only the uploader can update who it is shared with; nothing else changes; never deleted here.

    match /documents/{documentId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasAll(['tenantId', 'kind', 'fileName', 'contentType', 'size', 'driveFileId',
                                                 'driveLink', 'sharedWith', 'uploadedBy', 'uploadedAt'])
        && request.resource.data.keys().hasOnly(['tenantId', 'tenancyId', 'kind', 'label', 'fileName', 'contentType', 'size',
                                                  'driveFileId', 'driveLink', 'sharedWith', 'uploadedBy', 'uploadedAt'])
        && request.resource.data.kind in ['id-proof', 'agreement']
        && request.resource.data.contentType in ['image/jpeg', 'image/png', 'application/pdf']
        && request.resource.data.size is int && request.resource.data.size > 0
        && request.resource.data.size <= 15 * 1024 * 1024
        && request.resource.data.driveFileId is string && request.resource.data.driveFileId.size() > 0
        && request.resource.data.driveLink is string
        && request.resource.data.driveLink.matches('^https://(drive|docs)[.]google[.]com/.*')
        && request.resource.data.sharedWith is list && request.resource.data.sharedWith.size() <= 50
        && optionalText(request.resource.data, 'label', 60)
        && request.resource.data.fileName is string && request.resource.data.fileName.size() <= 200
        && request.resource.data.uploadedBy == myEmail()
        && request.resource.data.uploadedAt == request.time
        && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId));
      allow update: if isMember()
        && resource.data.uploadedBy == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith', 'updatedBy', 'updatedAt'])
        && request.resource.data.sharedWith is list && request.resource.data.sharedWith.size() <= 50
        && request.resource.data.updatedBy == myEmail()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---------- charges and payments ----------
    // Money is integer paise. Records are append-only: nothing is edited or deleted. An admin can
    // void (deleted = true) or restore a record with a reason; the change is audited.

    function matchesTenancy(d) {
      return exists(tenancyPath(d.tenancyId))
        && get(tenancyPath(d.tenancyId)).data.flatId == d.flatId
        && get(tenancyPath(d.tenancyId)).data.buildingId == d.buildingId;
    }

    function voidChange() {
      let d = request.resource.data;
      return isAdmin()
        && d.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy', 'deleteReason'])
        && d.deleted is bool
        && d.deletedBy == myEmail()
        && d.deletedAt == request.time
        && d.deleteReason is string && d.deleteReason.size() > 0 && d.deleteReason.size() <= 300;
    }

    // Undo straight after a one-tap payment: the person who saved it may cancel it within 2 minutes
    // (the app offers Undo for 10 seconds). It stays in the ledger as voided, like an admin void.
    function undoChange() {
      let d = request.resource.data;
      return isMember()
        && resource.data.createdBy == myEmail()
        && !('deleted' in resource.data)
        && request.time < resource.data.createdAt + duration.value(2, 'm')
        && d.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy', 'deleteReason'])
        && d.deleted == true
        && d.deletedBy == myEmail()
        && d.deletedAt == request.time
        && d.deleteReason == 'Undone right after saving';
    }

    function validCharge(chargeId) {
      let d = request.resource.data;
      return d.keys().hasAll(['tenancyId', 'flatId', 'buildingId', 'account', 'source', 'amount', 'due', 'createdAt', 'createdBy'])
        && d.keys().hasOnly(['tenancyId', 'flatId', 'buildingId', 'account', 'source', 'amount', 'due', 'start', 'end',
                             'monthlyRent', 'periodDays', 'occupiedDays', 'corrects', 'reverses', 'occupiedEnd',
                             'correctedAmount', 'reason', 'units', 'rate', 'billId', 'createdAt', 'createdBy',
                             'deleted', 'deletedAt', 'deletedBy', 'deleteReason'])
        && d.account in ['rent', 'electricity']
        && d.source in ['rent', 'opening', 'adjustment', 'submeter']
        && (d.source != 'submeter'
            || (d.account == 'electricity'
                && d.billId is string
                && chargeId == d.billId + '_elec_' + d.flatId
                && existsAfter(/databases/$(database)/documents/bills/$(d.billId))))
        && d.amount is int && d.amount != 0 && d.amount <= 1000000000 && d.amount >= -1000000000
        && (d.source == 'adjustment' || d.amount > 0)
        && isDate(d.due)
        && (d.source != 'rent' || (isDate(d.start) && chargeId == d.tenancyId + '_rent_' + d.start))
        && (d.source != 'opening' || (d.reason is string && d.reason.size() <= 300))
        && optionalText(d, 'reason', 300)
        && matchesTenancy(d);
    }

    match /charges/{chargeId} {
      allow read: if isMember();
      allow create: if isMember() && validCharge(chargeId) && createStamped() && !('deleted' in request.resource.data);
      allow update: if voidChange();
      allow delete: if false;
    }

    function validPayment() {
      let d = request.resource.data;
      return d.keys().hasAll(['tenancyId', 'flatId', 'buildingId', 'account', 'amount', 'date', 'method', 'createdAt', 'createdBy'])
        && d.keys().hasOnly(['tenancyId', 'flatId', 'buildingId', 'account', 'amount', 'date', 'method', 'reference', 'notes',
                             'manualAllocations', 'allocationReason', 'allocationBy', 'allocationAt',
                             'createdAt', 'createdBy', 'deleted', 'deletedAt', 'deletedBy', 'deleteReason'])
        && d.account in ['rent', 'electricity']
        && d.amount is int && d.amount > 0 && d.amount <= 1000000000
        && isDate(d.date)
        && d.method in ['cash', 'upi', 'bank', 'cheque', 'other']
        && optionalText(d, 'reference', 100)
        && optionalText(d, 'notes', 500)
        && (!('manualAllocations' in d) || d.manualAllocations == null || d.manualAllocations is map)
        && matchesTenancy(d);
    }

    // Any member may change how a payment is split across periods, with a reason.
    function reallocationChange() {
      let d = request.resource.data;
      return isMember()
        && validPayment()
        && d.diff(resource.data).affectedKeys().hasOnly(['manualAllocations', 'allocationReason', 'allocationBy', 'allocationAt'])
        && d.allocationReason is string && d.allocationReason.size() > 0 && d.allocationReason.size() <= 300
        && d.allocationBy == myEmail()
        && d.allocationAt == request.time;
    }

    match /payments/{paymentId} {
      allow read: if isMember();
      allow create: if isMember() && validPayment() && createStamped() && !('deleted' in request.resource.data);
      allow update: if voidChange() || reallocationChange() || undoChange();
      allow delete: if false;
    }

    // ---------- electricity: settings, bills and sub-meter readings ----------

    match /settings/app {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['electricityRate', 'updatedAt', 'updatedBy'])
        && request.resource.data.electricityRate is string
        && request.resource.data.electricityRate.matches('^[0-9]{1,4}([.][0-9]{1,2})?$')
        && request.resource.data.updatedBy == myEmail()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function validBill() {
      let d = request.resource.data;
      return d.keys().hasAll(['connectionId', 'billDate', 'periodStart', 'periodEnd', 'amount', 'dueDate', 'payer', 'status',
                              'createdAt', 'createdBy'])
        && d.keys().hasOnly(['connectionId', 'billDate', 'periodStart', 'periodEnd', 'amount', 'dueDate', 'payer', 'status',
                             'paidOn', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
                             'deleted', 'deletedAt', 'deletedBy', 'deleteReason'])
        && exists(/databases/$(database)/documents/connections/$(d.connectionId))
        && isDate(d.billDate) && isDate(d.periodStart) && isDate(d.periodEnd) && isDate(d.dueDate)
        && d.periodEnd >= d.periodStart
        && d.amount is int && d.amount > 0 && d.amount <= 1000000000
        && d.payer in ['family', 'tenant']
        && d.status in ['unpaid', 'paid']
        && (d.status == 'unpaid' || isDate(d.paidOn))
        && optionalText(d, 'notes', 500);
    }

    match /bills/{billId} {
      allow read: if isMember();
      allow create: if isMember() && validBill() && createStamped() && !('deleted' in request.resource.data);
      // Members mark a bill paid/unpaid or edit its notes; amounts and dates never change. Admins can void.
      allow update: if voidChange()
        || (isMember() && validBill()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidOn', 'notes', 'updatedAt', 'updatedBy'])
            && request.resource.data.updatedBy == myEmail()
            && request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    match /readings/{readingId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasAll(['flatId', 'connectionId', 'billId', 'previousReading', 'currentReading', 'units',
                                                 'previousDate', 'readingDate', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(['flatId', 'connectionId', 'billId', 'previousReading', 'currentReading', 'units',
                                                  'previousDate', 'readingDate', 'resetReason', 'chargeId',
                                                  'createdAt', 'createdBy', 'deleted', 'deletedAt', 'deletedBy', 'deleteReason'])
        && request.resource.data.previousReading.matches('^[0-9]{1,9}([.][0-9]{1,3})?$')
        && request.resource.data.currentReading.matches('^[0-9]{1,9}([.][0-9]{1,3})?$')
        && request.resource.data.units.matches('^[0-9]{1,9}([.][0-9]{1,3})?$')
        && isDate(request.resource.data.previousDate) && isDate(request.resource.data.readingDate)
        && request.resource.data.readingDate > request.resource.data.previousDate
        && optionalText(request.resource.data, 'resetReason', 300)
        && existsAfter(/databases/$(database)/documents/bills/$(request.resource.data.billId))
        && get(/databases/$(database)/documents/flats/$(request.resource.data.flatId)).data.connectionId == request.resource.data.connectionId
        && createStamped()
        && !('deleted' in request.resource.data);
      allow update: if voidChange();
      allow delete: if false;
    }

    // ---------- expense categories ----------

    match /categories/{categoryId} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['name', 'archived', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(['name', 'archived', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.archived is bool
        && (resource == null ? createStamped() : updateStamped());
      allow delete: if false;
    }

    // ---------- expenses ----------
    // Family members add expenses. Amount, date, building, flat, payer and the stored split never
    // change; description, category, payment mode and notes can. Admins can void/restore.

    function validExpense() {
      let d = request.resource.data;
      return d.keys().hasAll(['date', 'amount', 'categoryId', 'buildingId', 'payer', 'paymentMode', 'description', 'shares',
                              'createdAt', 'createdBy'])
        && d.keys().hasOnly(['date', 'amount', 'categoryId', 'buildingId', 'flatId', 'payer', 'paymentMode', 'description',
                             'notes', 'shares', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
                             'deleted', 'deletedAt', 'deletedBy', 'deleteReason'])
        && isDate(d.date)
        && d.amount is int && d.amount > 0 && d.amount <= 1000000000
        && d.payer in ['owner', 'tenant']
        && d.paymentMode in ['cash', 'upi', 'bank', 'cheque', 'other']
        && d.description is string && d.description.size() <= 200
        && optionalText(d, 'notes', 500)
        && d.shares is map && d.shares.size() >= 1 && d.shares.size() <= 100
        && exists(/databases/$(database)/documents/buildings/$(d.buildingId))
        && exists(/databases/$(database)/documents/categories/$(d.categoryId))
        && (!('flatId' in d) || d.flatId == null
            || (exists(/databases/$(database)/documents/flats/$(d.flatId))
                && get(/databases/$(database)/documents/flats/$(d.flatId)).data.buildingId == d.buildingId
                && d.shares.keys().hasOnly([d.flatId])));
    }

    match /expenses/{expenseId} {
      allow read: if isMember();
      allow create: if isMember() && validExpense() && createStamped()
        && !('deleted' in request.resource.data)
        && get(/databases/$(database)/documents/categories/$(request.resource.data.categoryId)).data.archived == false;
      allow update: if voidChange()
        || (isMember() && validExpense()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['categoryId', 'paymentMode', 'description', 'notes', 'updatedAt', 'updatedBy'])
            && request.resource.data.updatedBy == myEmail()
            && request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    // ---------- own reminders (title + date only) ----------

    match /reminders/{reminderId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['title', 'date', 'done', 'createdAt', 'createdBy'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && isDate(request.resource.data.date)
        && request.resource.data.done == false
        && createStamped();
      // Any member can mark a reminder done (or not done); the text never changes.
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneBy', 'doneAt'])
        && request.resource.data.done is bool
        && request.resource.data.doneBy == myEmail()
        && request.resource.data.doneAt == request.time;
      allow delete: if false;
    }

    // ---------- phone push registrations ----------
    // One document per device token; only the daily push job (server) reads them.

    match /pushTokens/{token} {
      allow read: if false;
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.email == myEmail();
    }

    // ---------- everything else ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
